# CloudUS — environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# Every variable here is server-only. Do not prefix any of them with NEXT_PUBLIC_.

# Supabase PostgreSQL, pooled connection (used by the app at runtime)
DATABASE_URL=

# Supabase PostgreSQL, direct connection (used by Prisma migrations and the seed)
DIRECT_URL=

# Initial admin account, created by `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shared secret the Google Apps Script sends as `Authorization: Bearer <secret>`.
# Generate a long random value, e.g. `openssl rand -base64 32`.
GOOGLE_APPS_SCRIPT_SECRET=replace_with_a_long_random_secret

# Shared secret for the scoring recovery endpoint, sent the same way:
# `Authorization: Bearer <secret>` against /api/internal/scoring-retry.
#
# Submission never depends on scoring succeeding, so a scoring failure leaves a
# submitted attempt without a result. A scheduler calling that endpoint every
# one to five minutes is what repairs them. Without this variable the endpoint
# refuses to serve (500) rather than running unauthenticated, so scoring
# recovery silently stops happening — set it in every environment.
#
# Generate a long random value, e.g. `openssl rand -base64 32`.
SCORING_RETRY_SECRET=replace_with_a_long_random_secret

# Optional. Connections this instance may open. Governed budget:
#   instances x DATABASE_POOL_SIZE <= 40
# (PostgreSQL max_connections is 60, less superuser and Supabase reservations.)
# Defaults to 8, hard-clamped at 20. Scale by adding instances, not by raising
# this — a larger pool on one instance starves its siblings.
# DATABASE_POOL_SIZE=8
