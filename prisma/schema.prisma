// CloudUS — Prisma schema
// Connection URLs live in prisma7.config.ts (Prisma 7 requirement).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  easy
  medium
  hard
}

enum OptionKey {
  a
  b
  c
  d
}

enum AttemptStatus {
  in_progress
  submitted
  auto_submitted
  /// Ended by the server because the candidate's unauthorized-activity count
  /// reached the configured limit. Distinct from auto_submitted, which is
  /// purely a timing outcome and carries no wrongdoing.
  terminated
}

/// Why an attempt was moved to `terminated`. A single value today, but kept as
/// an enum (rather than inferring the reason from `status` alone) so a future
/// termination cause does not have to overload this one.
enum TerminationReason {
  UNAUTHORIZED_ACTIVITY
}

enum ViolationType {
  TAB_SWITCH
  WINDOW_BLUR
  FULLSCREEN_EXIT
  COPY
  CUT
  PASTE
  CONTEXT_MENU
  KEYBOARD_SHORTCUT
  DEVTOOLS
  PRINT
  PAGE_LEAVE
  DRAG_DROP
  OTHER
}

/// Question bank. `id` is the stable identifier carried in from the CSV, so
/// re-importing a row updates it in place instead of creating a duplicate.
model Question {
  id              String     @id
  /// The canonical section code, and only ever one of the seven the exam
  /// blueprint defines: LOG, NUM, JS, OUT, BUG, STP or LRN. The set of valid
  /// values is the blueprint's, enforced by the importer and the admin editor
  /// rather than by a database enum, so adding a section does not require a
  /// type migration.
  ///
  section         String
  topic           String
  difficulty      Difficulty
  question        String
  codeBlock       String?    @map("code_block")
  /// Admin/internal verification reference. Never sent to a candidate: it is
  /// absent from the candidate paper's select list and from CandidateQuestion.
  verifyCode      String?    @map("verify_code")
  optionA         String     @map("option_a")
  optionB         String     @map("option_b")
  optionC         String     @map("option_c")
  optionD         String     @map("option_d")
  correct         OptionKey
  explanation     String?
  /// Section 7 only: the lesson shown above all 3 questions of its group.
  lessonText      String?    @map("lesson_text")
  /// Section 7 only: groups the 3 questions that share one lesson.
  lessonGroup     String?    @map("lesson_group")
  /// Every active section is scored, so this is true for every question the
  /// current exam can draw. It is retained because AttemptQuestion snapshots a
  /// copy of it, and historical scoring reads that snapshot.
  scored          Boolean    @default(true)
  marks           Decimal    @db.Decimal(4, 2)
  aiVerified      Boolean    @default(false) @map("ai_verified")
  trainerVerified Boolean    @default(false) @map("trainer_verified")
  /// Whether the question is eligible to be drawn into a newly generated
  /// paper. The only state a question has beyond its content: active or not.
  /// A freshly imported question always starts inactive — activation is a
  /// deliberate administrative act, never a side effect of import.
  isActive        Boolean    @default(false) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  attemptQuestions AttemptQuestion[]

  // Drawing a paper filters on section + is_active + difficulty.
  @@index([section, isActive, difficulty])
  @@index([lessonGroup])
  @@map("questions")
}

model Candidate {
  id                   String   @id @default(uuid())
  name                 String
  email                String
  mobile               String
  /// Set by the Google Apps Script sync; makes re-sending a registration idempotent.
  googleFormResponseId String?  @unique @map("google_form_response_id")
  registeredAt         DateTime @default(now()) @map("registered_at")

  // --- Live-sheet application/profile fields (Phase 12) ---------------------
  // Added for the upcoming candidate-CSV import (Phase 13). All nullable: an
  // existing candidate synced from the Google Form, or added by hand, carries
  // none of this and must remain valid without a backfill. Field-by-field
  // mapping from the spreadsheet is documented in
  // docs/candidate-import-field-mapping.md.
  //
  /// The row's timestamp on the source live sheet — distinct from `createdAt`,
  /// which is when this database row was written and may be much later (e.g.
  /// a bulk import run).
  sourceTimestamp         DateTime? @map("source_timestamp")
  currentCity             String?   @map("current_city")
  /// Free text on the sheet ("Yes" / "No" / other) rather than a clean
  /// boolean, so an inconsistent answer cannot fail the import.
  willingFullTimeSurat    String?   @map("willing_full_time_surat")
  dateOfBirth             DateTime? @map("date_of_birth") @db.Date
  highestQualification    String?   @map("highest_qualification")
  collegeName             String?   @map("college_name")
  yearOfPassing           String?   @map("year_of_passing")
  /// Free text ("8.5 CGPA", "75%", "N/A") — kept as-is rather than parsed to a
  /// number, since the sheet mixes formats.
  cgpaOrPercentage        String?   @map("cgpa_or_percentage")
  technologies            String?   @map("technologies") @db.Text
  projectInfo             String?   @map("project_info") @db.Text
  githubUrl               String?   @map("github_url")
  linkedinUrl             String?   @map("linkedin_url")
  liveProjectUrl          String?   @map("live_project_url")
  selfLearningInfo        String?   @map("self_learning_info") @db.Text
  aiToolsInfo             String?   @map("ai_tools_info") @db.Text
  reasonForJoining        String?   @map("reason_for_joining") @db.Text
  resumeUrl               String?   @map("resume_url")
  /// Free text on the sheet, same reasoning as `willingFullTimeSurat`.
  termsAgreement          String?   @map("terms_agreement")
  informationConfirmation String?   @map("information_confirmation")
  hearAboutProgram        String?   @map("hear_about_program")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attempts       Attempt[]
  candidateExams CandidateExam[]

  @@index([mobile])
  @@index([email])
  @@map("candidates")
}

/// "Is this candidate selected/eligible for this particular exam?" — separate
/// from Candidate, which only answers who the candidate is and what they
/// applied with. A candidate can exist without ever having a CandidateExam
/// row; existing/manual candidates today have none, and that must not make
/// them ineligible for anything that starts checking this table later.
///
/// A row's mere existence means "selected" — no INELIGIBLE state, since
/// nothing today needs to represent an explicit negative selection; add one
/// only when a real workflow needs it.
///
/// `examId` targets ExamSetting.id rather than a separate Exam model: the
/// codebase has no Exam model, only the ExamSetting singleton (id always
/// "singleton"). This keeps the relation correct today and forward-compatible
/// if ExamSetting is ever split into multiple rows.
model CandidateExam {
  id          String              @id @default(uuid())
  candidateId String              @map("candidate_id")
  examId      String              @map("exam_id")
  status      CandidateExamStatus @default(SELECTED)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  candidate Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  exam      ExamSetting @relation(fields: [examId], references: [id], onDelete: Cascade)

  // Prevents the same selected-candidate file from creating a duplicate
  // eligibility row when imported more than once.
  @@unique([candidateId, examId])
  @@index([examId])
  @@map("candidate_exams")
}

enum CandidateExamStatus {
  SELECTED
}

model Attempt {
  id                  String             @id @default(uuid())
  candidateId         String             @map("candidate_id")
  startedAt           DateTime           @default(now()) @map("started_at")
  submittedAt         DateTime?          @map("submitted_at")
  /// Wall-clock seconds the candidate actually spent; filled in on submission.
  durationSeconds     Int?               @map("duration_seconds")
  /// Null until scoring has run. Scoring only ever runs on a finalized attempt,
  /// and always recomputes the whole total from the stored paper and answers.
  totalScore          Decimal?           @map("total_score") @db.Decimal(5, 2)
  section1Score       Decimal?           @map("section_1_score") @db.Decimal(5, 2)
  section2Score       Decimal?           @map("section_2_score") @db.Decimal(5, 2)
  section3Score       Decimal?           @map("section_3_score") @db.Decimal(5, 2)
  section4Score       Decimal?           @map("section_4_score") @db.Decimal(5, 2)
  section5Score       Decimal?           @map("section_5_score") @db.Decimal(5, 2)
  section6Score       Decimal?           @map("section_6_score") @db.Decimal(5, 2)
  section7Score       Decimal?           @map("section_7_score") @db.Decimal(5, 2)
  /// Always 0: section 8 is stored but never scored. Kept as a column so the
  /// admin result view can render all eight sections from one row.
  section8Score       Decimal?           @map("section_8_score") @db.Decimal(5, 2)
  scoredAt            DateTime?          @map("scored_at")
  status              AttemptStatus      @default(in_progress)
  /// What the candidate typed on the start screen. Recorded here rather than
  /// written back to Candidate, because the Google Form record is the
  /// authoritative application data; keeping both lets an admin spot a
  /// candidate who entered a different name or email than they applied with.
  enteredName         String?            @map("entered_name")
  enteredEmail        String?            @map("entered_email")
  /// Where the candidate was working, as an AttemptQuestion.displayOrder within
  /// this attempt's own paper — not a Question id, which says nothing about
  /// display order once the paper is shuffled. Null on an attempt that has not
  /// reported a position yet, which is every attempt created before this
  /// column existed; resume then opens at the first question as it always did.
  currentDisplayOrder Int?               @map("current_display_order")
  /// Monotonic counter supplied by the browser with each position report. A
  /// report is only applied if it is newer than the stored one, so a slow write
  /// for question 20 landing after a fast write for question 23 cannot drag the
  /// candidate backwards. Visited state needs no equivalent: it is set-once per
  /// row and therefore cannot lose an earlier visit.
  currentPositionSeq  Int                @default(0) @map("current_position_seq")
  /// Server-authoritative count of recorded ExamViolation rows. Mirrors
  /// ExamViolation's count for this attempt; kept as a denormalized counter so
  /// the limit check does not require a count(*) on every violation.
  violationCount      Int                @default(0) @map("violation_count")
  /// Set only when status is `terminated`.
  terminationReason   TerminationReason? @map("termination_reason")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  candidate        Candidate         @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  attemptQuestions AttemptQuestion[]
  answers          Answer[]
  examSessions     ExamSession[]
  violations       ExamViolation[]

  // "One active attempt per candidate" is a partial unique index on
  // (candidate_id) WHERE status = 'in_progress'. Prisma's schema syntax has no
  // partial-index form, so it is added by hand in the migration SQL.
  @@index([candidateId, status])
  @@index([status])
  @@index([startedAt])
  @@index([submittedAt])
  @@index([scoredAt])
  @@map("attempts")
}

/// One detected anti-cheating event during a sitting. Append-only audit trail:
/// rows are never updated or deleted, only created as events are detected.
model ExamViolation {
  id         String        @id @default(uuid())
  attemptId  String        @map("attempt_id")
  type       ViolationType
  detectedAt DateTime      @default(now()) @map("detected_at")
  /// Safe, non-identifying detail only (e.g. which key combo, which fullscreen
  /// element). Never free-form candidate input.
  metadata   Json?
  /// 1-based order among this attempt's violations, so the admin log and the
  /// "Warning N of LIMIT" wording share one authoritative counter.
  sequence   Int
  createdAt  DateTime      @default(now()) @map("created_at")

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, sequence])
  @@map("exam_violations")
}

/// The drawn paper, persisted once at exam start so refresh/resume never redraws.
model AttemptQuestion {
  id                  String      @id @default(uuid())
  attemptId           String      @map("attempt_id")
  questionId          String      @map("question_id")
  /// The section's historical number, not its code. This is a snapshot of the
  /// paper as drawn: it stays an Int so papers sat under the previous
  /// eight-section structure remain readable exactly as they were recorded.
  section             Int
  displayOrder        Int         @map("display_order")
  /// Option order used for this attempt, e.g. [c, a, d, b].
  shuffledOptionOrder OptionKey[] @map("shuffled_option_order")

  // Snapshot of the question exactly as it was shown. The question bank stays
  // editable, so result review reads these rather than the live Question row.
  // Only codeBlock and explanation are nullable, matching Question itself.
  questionText String    @map("question_text")
  codeBlock    String?   @map("code_block")
  optionA      String    @map("option_a")
  optionB      String    @map("option_b")
  optionC      String    @map("option_c")
  optionD      String    @map("option_d")
  correct      OptionKey
  explanation  String?
  /// Section 7 only: the lesson shown above the three questions of its group,
  /// snapshotted so a historical paper renders without the live Question row.
  lessonText   String?   @map("lesson_text")
  lessonGroup  String?   @map("lesson_group")
  marks        Decimal   @db.Decimal(4, 2)
  /// Snapshot of Question.scored. False for section 8. Scoring reads this rather
  /// than the live question, so flipping the flag in the bank cannot retroactively
  /// change what an already-sat paper was worth.
  scored       Boolean   @default(true)
  /// When the candidate first opened this question. Null means never seen, which
  /// is exactly the palette's "Not seen" state. Set once and never cleared, so
  /// two concurrent writes cannot lose an earlier visit and no versioning is
  /// needed. "Answered" is still derived from the Answer row, not from here.
  visitedAt    DateTime? @map("visited_at")

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answer   Answer?

  @@unique([attemptId, questionId])
  @@unique([attemptId, displayOrder])
  @@index([questionId])
  @@map("attempt_questions")
}

model Answer {
  id                String     @id @default(uuid())
  attemptId         String     @map("attempt_id")
  attemptQuestionId String     @unique @map("attempt_question_id")
  /// Null for section 8, which answers with free text instead.
  selectedOption    OptionKey? @map("selected_option")
  /// Section 8 only.
  textAnswer        String?    @map("text_answer")
  /// Null until scoring runs, and stays null for unscored section 8.
  isCorrect         Boolean?   @map("is_correct")
  marksAwarded      Decimal?   @map("marks_awarded") @db.Decimal(4, 2)
  answeredAt        DateTime   @default(now()) @map("answered_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  attempt         Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptQuestion AttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("answers")
}

/// Exam configuration the admin can change at runtime. The fixed shape of the
/// paper — section names, question counts and marks — is a domain rule and
/// lives in lib/exam-settings/exam-blueprint.ts instead.
///
/// Exactly one row exists. `id` is pinned to a known value and a check
/// constraint in the migration rejects any other, so a second configuration
/// cannot be created even by accident.
model ExamSetting {
  id                        String   @id @default("singleton")
  examName                  String   @map("exam_name")
  durationMinutes           Int      @map("duration_minutes")
  /// Closed by default so a fresh deployment can never accidentally admit
  /// candidates before an admin opens the exam.
  isOpen                    Boolean  @default(false) @map("is_open")
  /// Target difficulty mix for a drawn paper, as whole percentages summing to
  /// 100. Unlike the section counts, this is genuinely tunable, so the
  /// requirements call for it to be admin-editable.
  easyPercent               Int      @default(40) @map("easy_percent")
  mediumPercent             Int      @default(40) @map("medium_percent")
  hardPercent               Int      @default(20) @map("hard_percent")
  /// Number of recorded violations a single attempt may reach before it is
  /// automatically terminated. Not a UI constant: the anti-cheating layer
  /// always reads this rather than a hardcoded number.
  unauthorizedActivityLimit Int      @default(3) @map("unauthorized_activity_limit")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  candidateExams CandidateExam[]

  @@map("exam_settings")
}

/// Ties a browser to one attempt for the duration of an exam sitting.
///
/// Candidates have no accounts, so this is not authentication: it is a capability
/// scoped to a single attempt, issued by the server when eligibility has already
/// been proven. As with admin sessions the cookie carries a random opaque token
/// and only its SHA-256 hash is stored, so a database dump cannot be replayed.
model ExamSession {
  id        String   @id @default(uuid())
  attemptId String   @map("attempt_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([expiresAt])
  @@map("exam_sessions")
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions AdminSession[]

  @@map("admins")
}

/// Server-side admin sessions. The cookie carries a random opaque token; only
/// its SHA-256 hash is stored here, so a leaked database dump cannot be
/// replayed as a live session.
model AdminSession {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}
